  <DataSets>
    <DataSet Name="KPI">
      <Query>
        <DataSourceName>Retail_Operations_Model</DataSourceName>
        <rd:DesignerState>
          <QueryDefinition xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://schemas.microsoft.com/AnalysisServices/QueryDefinition">
            <CommandType>DAX</CommandType>
            <Type>Query</Type>
            <QuerySpecification xsi:type="MDXQuerySpecification">
              <Select>
                <Items>
                  <Item>
                    <ID xsi:type="Column">
                      <ColumnName>[Total Sales]</ColumnName>
                    </ID>
                    <ItemCaption>Total Sales</ItemCaption>
                  </Item>
                  <Item>
                    <ID xsi:type="Column">
                      <ColumnName>[Total Transactions]</ColumnName>
                    </ID>
                    <ItemCaption>Total Transactions</ItemCaption>
                  </Item>
                  <Item>
                    <ID xsi:type="Column">
                      <ColumnName>[Total Units]</ColumnName>
                    </ID>
                    <ItemCaption>Total Units</ItemCaption>
                  </Item>
                  <Item>
                    <ID xsi:type="Column">
                      <ColumnName>[Gross Profit]</ColumnName>
                    </ID>
                    <ItemCaption>Gross Profit</ItemCaption>
                  </Item>
                  <Item>
                    <ID xsi:type="Column">
                      <ColumnName>[Total Returns]</ColumnName>
                    </ID>
                    <ItemCaption>Total Returns</ItemCaption>
                  </Item>
                </Items>
              </Select>
              <AutoExecute>false</AutoExecute>
              <From>Model</From>
              <Filter>
                <FilterItems />
              </Filter>
              <Calculations />
              <Aggregates />
              <QueryProperties />
            </QuerySpecification>
            <Query>
              <Statement>EVALUATE
ROW(
    "Total Sales", SUM(Transactions[total_amount]),
    "Total Transactions", COUNTROWS(Transactions),
    "Total Units", SUM(Items[quantity]),
    "Gross Profit", SUM(Items[gross_profit]),
    "Total Returns", SUM(Returns[refund_amount])
)</Statement>
              <ParameterDefinitions />
            </Query>
          </QueryDefinition>
        </rd:DesignerState>
        <CommandText>EVALUATE
ROW(
    "Total Sales", SUM(Transactions[total_amount]),
    "Total Transactions", COUNTROWS(Transactions),
    "Total Units", SUM(Items[quantity]),
    "Gross Profit", SUM(Items[gross_profit]),
    "Total Returns", SUM(Returns[refund_amount])
)

</CommandText>
      </Query>
      <Fields>
        <Field Name="ID_Total_Sales_">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>[Total Sales]</DataField>
        </Field>
        <Field Name="ID_Total_Transactions_">
          <rd:TypeName>System.Int64</rd:TypeName>
          <DataField>[Total Transactions]</DataField>
        </Field>
        <Field Name="ID_Total_Units_">
          <rd:TypeName>System.Int64</rd:TypeName>
          <DataField>[Total Units]</DataField>
        </Field>
        <Field Name="ID_Gross_Profit_">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>[Gross Profit]</DataField>
        </Field>
        <Field Name="ID_Total_Returns_">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>[Total Returns]</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="StoreOperations">
      <Query>
        <DataSourceName>Retail_Operations_Model</DataSourceName>
        <CommandText>EVALUATE
SUMMARIZECOLUMNS(
    Regions[name],
    Stores[name],
    "Total Transactions", COUNTROWS(Transactions),
    "Total Sales", SUM(Transactions[total_amount]),
    "Total Units", SUM(Items[quantity]),
    "Gross Profit", SUM(Items[gross_profit]),
    "Total Returns", SUM(Returns[refund_amount])
)
ORDER BY
    Regions[name],
    Stores[name]</CommandText>
      </Query>
      <Fields>
        <Field Name="regions_name_">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>regions[name]</DataField>
        </Field>
        <Field Name="stores_name_">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>stores[name]</DataField>
        </Field>
        <Field Name="ID_Total_Transactions_">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[Total Transactions]</DataField>
        </Field>
        <Field Name="ID_Total_Sales_">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[Total Sales]</DataField>
        </Field>
        <Field Name="ID_Total_Units_">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[Total Units]</DataField>
        </Field>
        <Field Name="ID_Gross_Profit_">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[Gross Profit]</DataField>
        </Field>
        <Field Name="ID_Total_Returns_">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[Total Returns]</DataField>
        </Field>
      </Fields>
    </DataSet>
