    <DataSet Name="KPI">
      <Query>
        <DataSourceName>Retail_Operations_Model</DataSourceName>
        <rd:DesignerState>
          <QueryDefinition xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://schemas.microsoft.com/AnalysisServices/QueryDefinition">
            <CommandType>DAX</CommandType>
            <Type>Query</Type>
            <QuerySpecification xsi:type="MDXQuerySpecification">
              <Select>
                <Items>
                  <Item>
                    <ID xsi:type="Column">
                      <ColumnName>[Total Sales]</ColumnName>
                    </ID>
                    <ItemCaption>Total Sales</ItemCaption>
                  </Item>
                  <Item>
                    <ID xsi:type="Column">
                      <ColumnName>[Total Transactions]</ColumnName>
                    </ID>
                    <ItemCaption>Total Transactions</ItemCaption>
                  </Item>
                  <Item>
                    <ID xsi:type="Column">
                      <ColumnName>[Total Units]</ColumnName>
                    </ID>
                    <ItemCaption>Total Units</ItemCaption>
                  </Item>
                  <Item>
                    <ID xsi:type="Column">
                      <ColumnName>[Gross Profit]</ColumnName>
                    </ID>
                    <ItemCaption>Gross Profit</ItemCaption>
                  </Item>
                  <Item>
                    <ID xsi:type="Column">
                      <ColumnName>[Total Returns]</ColumnName>
                    </ID>
                    <ItemCaption>Total Returns</ItemCaption>
                  </Item>
                </Items>
              </Select>
              <AutoExecute>false</AutoExecute>
              <From>Model</From>
              <Filter>
                <FilterItems />
              </Filter>
              <Calculations />
              <Aggregates />
              <QueryProperties />
            </QuerySpecification>
            <Query>
              <Statement>EVALUATE
ROW(
    "Total Sales", SUM(Transactions[total_amount]),
    "Total Transactions", COUNTROWS(Transactions),
    "Total Units", SUM(Items[quantity]),
    "Gross Profit", SUM(Items[gross_profit]),
    "Total Returns", SUM(Returns[refund_amount])
)</Statement>
              <ParameterDefinitions />
            </Query>
          </QueryDefinition>
        </rd:DesignerState>
        <CommandText>EVALUATE
ROW(
    "Total Sales", SUM(Transactions[total_amount]),
    "Total Transactions", COUNTROWS(Transactions),
    "Total Units", SUM(Items[quantity]),
    "Gross Profit", SUM(Items[gross_profit]),
    "Total Returns", SUM(Returns[refund_amount])
)

</CommandText>
      </Query>
